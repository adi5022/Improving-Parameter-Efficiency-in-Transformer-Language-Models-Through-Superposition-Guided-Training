  "steps": 300,
  "batch_size": 16,
  "grad_accum": 2,
  "peak_lr": 0.003,
  "warmup_steps": 20,
  "final_lr_frac": 0.1,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "precision": "fp32",
  "compile": false,
  "eval_every": 50,
  "eval_windows": 64,
  "eval_batch_size": 16,
  "log_every": 10,
  "ckpt_every": 100,
  "keep_last_ckpts": 2
}
