{
  "_note": "PLACEHOLDER, NOT APPROVED. A tiny CPU dry run of the training machinery on a synthetic byte-level corpus. None of these values is a project decision.",
  "run_name": "dryrun",
  "seed": 0,
  "data_dir": "results/lm_data/synthetic_v0",
  "model": {
    "n_layer": 3,
    "d_model": 96,
    "n_head": 4,
    "d_ff": 256,
    "vocab_size": 256,
